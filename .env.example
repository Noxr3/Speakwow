# ============ Speakwow environment variables ============
# One file per environment (dev / staging / prod); the code has no environment
# branches. Secrets never go in the repository.
# Each app has its own .env.example with only what it reads:
#   apps/web/.env.example, apps/agent/.env.example

# --- LiveKit (web + agent) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Voice model (agent) ---
REALTIME_PROVIDER=xai            # xai | openai
XAI_API_KEY=                     # operator key; optional if every user brings their own
OPENAI_API_KEY=
XAI_REALTIME_MODEL=              # default grok-voice-3.0 (pinned)
OPENAI_REALTIME_MODEL=           # default gpt-realtime-2.1
TURN_SILENCE_MS=                 # default 1100 beginners / 750 B1+ adults

# --- Fast models around the conversation (agent) ---
AI_GATEWAY_API_KEY=              # Vercel AI Gateway: Jev coaching sidecar + flash reflection
COACH=                           # "off" disables the coaching sidecar
MEMORY_LLM_API_KEY=              # or any OpenAI-compatible endpoint for reflection
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=

# --- Supabase (optional: accounts, memory, courses) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=       # server only (agent, scripts, web API routes), never NEXT_PUBLIC

# --- Bring your own key (web + agent share the same value) ---
BYOK_ENCRYPTION_KEY=             # openssl rand -base64 32
REQUIRE_BYOK=                    # "true": every call must bring its own key
ALLOW_GUESTS=                    # "false": only signed-in students can call

# --- Phone calls and texts (docs/PHONE_AND_SMS.md) ---
TWILIO_ACCOUNT_SID=              # web + sms server: codes that link a phone, and sending replies
TWILIO_AUTH_TOKEN=               # web + sms server (checks Twilio's signature)
TWILIO_VERIFY_SERVICE_SID=       # web
SPEAKWOW_PHONE_NUMBER=           # web: the teacher line shown in Settings
SMS_WEBHOOK_URL=                 # sms server: the exact URL Twilio posts texts to
SMS_MODEL=                       # sms server: default deepseek/deepseek-v4.1-flash via the AI Gateway
SMS_LLM_API_KEY=                 # or any OpenAI-compatible endpoint for texts
SMS_LLM_BASE_URL=
SMS_DAILY_LIMIT=                 # texts a student can send per day and channel, default 60
PHONE_MAX_MINUTES=               # agent: a phone call ends after this, default 40
PHONE_TRUST_UNVERIFIED=          # agent: "on" trusts caller IDs the carrier did not verify (outside the US)

# --- Not wired yet: Azure pronunciation assessment, Stripe ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
