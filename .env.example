# ============ Speakwow monorepo 环境变量清单（C1-C 定稿） ============
# 每个环境（dev/staging/prod）一份 .env；环境差异只体现在变量，代码零分支。
# 密钥一律不入仓库；CI 发现 sk-/pk_live_/oag_ 形态字符串直接红。

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # 仅服务端/agent（Railway），绝不进 NEXT_PUBLIC

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- AI ---
XAI_API_KEY=                    # Grok realtime（实时对话）
OPENAI_API_KEY=                 # 结构化练习 feedback 生成（talkabout/write）

# --- Azure Speech（仅结构化练习发音评测） ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- 应用 ---
AGENT_NAME=
