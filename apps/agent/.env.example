# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice model: xai (default, Grok Voice) or openai (Realtime)
REALTIME_PROVIDER=xai
XAI_API_KEY=
OPENAI_API_KEY=
# XAI_REALTIME_MODEL=grok-voice-3.0
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# TURN_SILENCE_MS=1100   # unset: 1100 beginners, 750 B1+ adults

# Coaching sidecar (Jev) + flash-model reflection through the Vercel AI Gateway
AI_GATEWAY_API_KEY=
# COACH=off
# Or reflect with any OpenAI-compatible model:
# MEMORY_LLM_API_KEY=
# MEMORY_LLM_BASE_URL=
# MEMORY_LLM_MODEL=

# Memory (optional). The service-role key stays on the agent's server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bring your own key: the same value as the web app's
BYOK_ENCRYPTION_KEY=

# Text messages: a second process from this image, `uv run src/sms_server.py`
# (docs/PHONE_AND_SMS.md)
# TWILIO_AUTH_TOKEN=
# SMS_WEBHOOK_URL=https://sms.example.com/twilio/sms
# SMS_MODEL=deepseek/deepseek-v4.1-flash   # through AI_GATEWAY_API_KEY
# SMS_LLM_API_KEY=                         # or any OpenAI-compatible endpoint
# SMS_LLM_BASE_URL=
# SMS_DAILY_LIMIT=60
