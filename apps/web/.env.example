# LiveKit
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Supabase (optional: without it everyone talks as a guest and nothing is remembered)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bring your own key: 32 random bytes, base64 (openssl rand -base64 32).
# The agent needs the same value.
BYOK_ENCRYPTION_KEY=
# REQUIRE_BYOK=true    # every call must bring its own key
# ALLOW_GUESTS=false   # only signed-in students can start a call

# Phone calls and texts (docs/PHONE_AND_SMS.md). Settings → Phone appears once
# these and SUPABASE_SERVICE_ROLE_KEY are set; the key stays server-side.
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# SPEAKWOW_PHONE_NUMBER=+15550100000

# LiveKit Cloud sandbox (template leftovers, unused by default)
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
